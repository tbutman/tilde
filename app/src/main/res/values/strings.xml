    <string name="welcome_mode_title">How will you share?</string>
    <string name="welcome_mode_body">Your phone is all you need. An NFC card or sticker can share your link too, even when your phone stays in your pocket.</string>
    <string name="welcome_mode_phone">Just my phone</string>
    <string name="welcome_mode_phone_detail">Tap phones, or show your code. Nothing else needed.</string>
    <string name="welcome_mode_card">My phone and a card or sticker</string>
    <string name="welcome_mode_card_detail">Next, put your link on it with Write a card. No card yet? Skip that step and write one any time from Settings.</string>
    <string name="welcome_get_card">No card yet? Print your own</string>
    <string name="welcome_get_card_detail">Got a 3D printer? The Tilde card design is free: add your details, print it, and seal an NFC sticker inside.</string>

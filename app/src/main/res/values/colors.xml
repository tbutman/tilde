<?xml version="1.0" encoding="utf-8"?>
<!-- The light palette (Settings → Theme: Light, or Follow system in light mode). Same names as the
     dark palette in values-night; the amber is darker here so text in it stays readable on white. -->
<resources>
    <color name="bg">#F4F3EF</color>
    <color name="panel">#FFFFFF</color>
    <color name="panel_raised">#FFFFFF</color>
    <color name="line">#E2E0D9</color>
    <color name="line_strong">#CCC9BF</color>
    <!-- Outlines that show where to type or tap (empty fields, the country buttons): 3:1 on bg. -->
    <color name="field_outline">#8E8A7E</color>
    <color name="text">#15181D</color>
    <color name="muted">#545C67</color>
    <color name="dim">#68717C</color>
    <color name="accent">#A85F00</color>
    <color name="accent_soft">#26A85F00</color>
    <color name="qr_light">#FFFFFF</color>
    <color name="qr_hint">#5B6470</color>
    <color name="ok">#23803F</color>
    <color name="danger">#B93A1F</color>
    <color name="sent_scrim">#F2F4F3EF</color>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- The light theme; values-night/themes.xml is the dark one, Tilde's default. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Tilde" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryContainer">@color/accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/accent</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorSurfaceContainer">@color/panel</item>
        <item name="colorSurfaceContainerLow">@color/panel</item>
        <item name="colorSurfaceContainerHigh">@color/panel_raised</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <!-- Unfocused text fields and outlined buttons: at least 3:1 against the background (WCAG 1.4.11). -->
        <item name="colorOutline">@color/field_outline</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/panel</item>
        <!-- Dark status bar and navigation icons on the light background. -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Tilde.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.Tilde.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurfaceContainerLow">@color/panel</item>
    </style>
</resources>

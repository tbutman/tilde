<?xml version="1.0" encoding="utf-8"?>
<!-- What the other person looks at: name, QR code, and what a tap shares. Settings live elsewhere. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- ~/handle, and the card's label with more than one card; opens the card switcher. -->
            <TextView
                android:id="@+id/brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:ellipsize="end"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:fontFamily="monospace"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:minHeight="32dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- The card, with an edit button over its cover band. Tap the card for the card switcher,
             long-press or tap the pencil to edit it, swipe it for the next card. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <include
                android:id="@+id/profile_card"
                layout="@layout/view_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <ImageButton
                android:id="@+id/card_edit"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_edit_button"
                android:contentDescription="@string/edit_card"
                android:padding="11dp"
                android:src="@drawable/ic_edit"
                app:tint="@color/text" />
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/set_up_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="@string/set_up_profile"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/qr_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/qr_light"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/qr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/qr_description"
                android:padding="8dp"
                android:scaleType="fitCenter" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Instead of the code, when what it would carry doesn't fit in one. -->
        <TextView
            android:id="@+id/qr_too_long"
            style="@style/Hint"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/qr_too_long"
            android:visibility="gone" />

        <!-- For the other person: what scanning or tapping opens. -->
        <TextView
            android:id="@+id/qr_opens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="middle"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <!-- Quick switch: the starred options, one tap each. Swiping the code steps through them too. -->
        <HorizontalScrollView
            android:id="@+id/quick_switch_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/quick_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/wifi_missing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Hint"
                android:gravity="center"
                android:text="@string/wifi_missing" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_settings"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/open_settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/iphone_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/nfc_settings"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/open_nfc_settings"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/share_row"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/panel"
            app:strokeColor="@color/line_strong">

            <include android:id="@+id/share_row_content" layout="@layout/row_preset" />
        </com.google.android.material.card.MaterialCardView>

        <!-- For people who aren't in front of you: hand the link or card to another app. -->
        <LinearLayout
            android:id="@+id/share_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/share_send"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/share_send"
                app:icon="@drawable/ic_nav_share" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/share_copy"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/share_copy"
                app:icon="@drawable/ic_copy" />
        </LinearLayout>

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/dim"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>

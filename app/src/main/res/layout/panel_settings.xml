<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: the active card (tap to edit), then short rows that each open their own page and show
     what they're set to now. The card's details live in Edit card; settings for every card live in
     Sharing, Guest Wi-Fi and About. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_settings"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView style="@style/Label" android:text="@string/settings_this_card" />

        <!-- The active card: tap to edit everything on it. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_card"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/panel_raised"
            app:strokeColor="@color/line_strong">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <include
                    android:id="@+id/settings_avatar"
                    layout="@layout/view_avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/settings_card_dot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_dot" />

                        <TextView
                            android:id="@+id/settings_card_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/dim"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/settings_card_name"
                        style="@style/RowTitle"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/settings_card_summary"
                        style="@style/RowDetail"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/edit_card"
                    android:textColor="@color/accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <include android:id="@+id/row_cards" layout="@layout/row_setting" />

        <TextView style="@style/Label" android:text="@string/settings_all_cards" />

        <include android:id="@+id/row_sharing" layout="@layout/row_setting" />

        <include android:id="@+id/row_wifi" layout="@layout/row_setting" />

        <include android:id="@+id/row_met" layout="@layout/row_setting" />

        <include android:id="@+id/row_write" layout="@layout/row_setting" />

        <TextView style="@style/Label" android:text="@string/settings_app" />

        <include android:id="@+id/row_backup" layout="@layout/row_setting" />

        <include android:id="@+id/row_theme" layout="@layout/row_setting" />

        <include android:id="@+id/row_language" layout="@layout/row_setting" />

        <include android:id="@+id/row_tile" layout="@layout/row_setting" />

        <include android:id="@+id/row_about" layout="@layout/row_setting" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Panel">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tab_settings"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />


        <TextView style="@style/Label" android:text="@string/settings_profile" />

        <TextView style="@style/Hint" android:text="@string/profile_detail" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/settings_avatar"
                layout="@layout/view_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/photo_pick"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/photo_add" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/photo_remove"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/photo_remove" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/profile_name"
            android:labelFor="@id/profile_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/profile_title"
            android:labelFor="@id/profile_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/profile_email"
            android:labelFor="@id/profile_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/profile_website"
            android:labelFor="@id/profile_website">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_website"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/profile_handle"
            android:labelFor="@id/profile_handle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_handle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/profile_linkedin"
            android:labelFor="@id/profile_linkedin">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_linkedin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/profile_github"
            android:labelFor="@id/profile_github">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_github"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/profile_instagram"
            android:labelFor="@id/profile_instagram">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_instagram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/profile_x"
            android:labelFor="@id/profile_x">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_x"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView style="@style/Label" android:text="@string/settings_phones" />

        <TextView style="@style/Hint" android:text="@string/phones_detail" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/phone_label"
            android:labelFor="@id/phone1_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/phone1_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/phone_number"
            android:labelFor="@id/phone1_number">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/phone1_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/phone_label"
            android:labelFor="@id/phone2_label">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/phone2_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/phone_number"
            android:labelFor="@id/phone2_number">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/phone2_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/profile_whatsapp"
            android:labelFor="@id/profile_whatsapp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/profile_whatsapp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView style="@style/Label" android:text="@string/settings_sharing" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/toggle"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView style="@style/Hint" android:text="@string/toggle_detail" />

        <TextView style="@style/Label" android:text="@string/settings_event" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/event_hint"
            android:labelFor="@id/event">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView style="@style/Hint" android:layout_marginTop="6dp" android:text="@string/event_detail" />

        <LinearLayout
            android:id="@+id/whatsapp_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Label" android:text="@string/settings_whatsapp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Field"
                android:hint="@string/whatsapp_greeting_hint"
                android:labelFor="@id/whatsapp_greeting">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/whatsapp_greeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView style="@style/Hint" android:layout_marginTop="6dp" android:text="@string/whatsapp_detail" />
        </LinearLayout>

        <TextView style="@style/Label" android:text="@string/settings_custom" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/url_layout"
            style="@style/Field"
            android:hint="@string/settings_custom"
            android:labelFor="@id/url">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView style="@style/Label" android:text="@string/settings_wifi" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Field"
            android:hint="@string/wifi_ssid_label"
            android:labelFor="@id/wifi_ssid">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/wifi_ssid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/wifi_password_layout"
            style="@style/Field"
            android:hint="@string/wifi_password_label"
            android:labelFor="@id/wifi_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/wifi_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/wifi_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wifi_open" />

        <TextView style="@style/Hint" android:text="@string/wifi_detail" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wifi_settings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/wifi_open_settings" />

        <TextView style="@style/Label" android:text="@string/settings_write" />

        <TextView style="@style/Hint" android:text="@string/settings_write_detail" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/write_card"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/write_open" />

        <LinearLayout
            android:id="@+id/tile_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView style="@style/Label" android:text="@string/settings_shortcuts" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_tile"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_tile" />
        </LinearLayout>

        <TextView style="@style/Label" android:text="@string/settings_about" />

        <TextView android:id="@+id/reads" style="@style/Hint" android:fontFamily="monospace" />

        <TextView android:id="@+id/version" style="@style/Hint" android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>

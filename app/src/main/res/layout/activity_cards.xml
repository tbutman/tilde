<?xml version="1.0" encoding="utf-8"?>
<!-- Manage cards: rename and colour, duplicate, reorder and delete. Rows are added in code. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Panel"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="24dp">

        <TextView
            style="@style/StepTitle"
            android:paddingHorizontal="24dp"
            android:text="@string/cards_title"
            android:textSize="22sp" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="24dp"
            android:text="@string/cards_manage_detail" />

        <LinearLayout
            android:id="@+id/cards_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cards_new"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:text="@string/cards_new"
            app:icon="@drawable/ic_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cards_done"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="16dp"
            android:text="@string/write_close" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- Write a card: choose what to write, then hold a sticker or printed card to the phone. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Panel"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/write_title"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="8dp"
            android:text="@string/write_body" />

        <!-- With more than one card: which card's details are written. -->
        <TextView
            android:id="@+id/write_from"
            style="@style/Hint"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/accent"
            android:visibility="gone" />

        <TextView style="@style/Label" android:text="@string/write_what" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/write_choice"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/panel"
            app:strokeColor="@color/line_strong">

            <include android:id="@+id/write_choice_content" layout="@layout/row_preset" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/panel_raised">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:minHeight="240dp"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/write_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tile" />

                <TextView
                    android:id="@+id/write_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/write_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/muted"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/write_nfc_settings"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/open_nfc_settings"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Hint"
            android:layout_marginTop="16dp"
            android:text="@string/write_note" />

        <!-- Off by default; ticking it asks for confirmation (locking is permanent). -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/write_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/write_lock" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/write_close"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:text="@string/write_close" />

        <!-- Opened from the welcome screens only: where to find this screen later. -->
        <TextView
            android:id="@+id/write_later"
            style="@style/Hint"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:text="@string/write_later"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>

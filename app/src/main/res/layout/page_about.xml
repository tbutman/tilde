<?xml version="1.0" encoding="utf-8"?>
<!-- Settings → About: version, the website, privacy, source code, reporting a problem and the
     licences. Debug builds add the welcome reset. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Panel"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView style="@style/StepTitle" android:text="@string/settings_about" android:textSize="22sp" />

        <TextView android:id="@+id/version" style="@style/Hint" android:layout_marginTop="8dp" android:fontFamily="monospace" />

        <TextView android:id="@+id/reads" style="@style/Hint" android:fontFamily="monospace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_website"
            android:gravity="start|center_vertical"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="8dp"
            android:text="@string/about_website" />

        <TextView style="@style/Label" android:layout_marginTop="28dp" android:text="@string/about_privacy" />

        <TextView style="@style/Hint" android:text="@string/about_privacy_detail" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_privacy"
            android:gravity="start|center_vertical"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:text="@string/about_privacy_link" />

        <TextView style="@style/Label" android:layout_marginTop="28dp" android:text="@string/about_source" />

        <TextView style="@style/Hint" android:text="@string/about_source_detail" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_source"
            android:gravity="start|center_vertical"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:text="@string/about_source_link" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_issues"
            android:gravity="start|center_vertical"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:text="@string/about_issues" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_licences"
            android:gravity="start|center_vertical"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:text="@string/about_licences" />

        <TextView style="@style/Label" android:layout_marginTop="28dp" android:text="@string/about_delete_title" />

        <TextView style="@style/Hint" android:text="@string/about_delete_detail" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_all"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/about_delete"
            android:textColor="@color/danger" />

        <!-- Debug builds only: start the welcome screens again with an empty profile. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/debug_welcome"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/debug_welcome"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/page_done"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="24dp"
            android:text="@string/write_close" />
    </LinearLayout>
</ScrollView>
